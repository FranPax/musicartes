---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { pages } from "@/data/pages";
import { pathPairs } from "@/data/site";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.path === "/" ? undefined : page.path.replace(/^\/|\/$/g, "") },
    props: { page }
  }));
}

const { page } = Astro.props;
const pairId = Object.entries(pathPairs).find(([, pair]) => pair.es === page.path || pair.en === page.path)?.[0];
const isHome = page.path === "/" || page.path === "/en/";
---
<BaseLayout title={page.title} description={page.description} lang={page.lang} path={page.path} pairId={pairId}>
  <section class:list={["hero", { "hero-home": isHome }]}>
    <div class="hero-copy">
      <h1>{page.h1}</h1>
      <p>{page.intro}</p>
      {page.cta && <a class="button" href={page.cta.href}>{page.cta.label}</a>}
    </div>
    {isHome && (
      <div class="hero-media" aria-hidden="true">
        <div class="staff-lines"></div>
        <div class="media-card">
          <span>Marimba</span>
          <strong>Derechos conexos</strong>
          <small>Guatemala</small>
        </div>
      </div>
    )}
  </section>

  <section class="content-grid">
    {page.sections.map((section) => (
      <article class="section-block">
        <h2>{section.title}</h2>
        <p>{section.body}</p>
        {section.items && (
          <ul>
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {section.links && (
          <div class="inline-links">
            {section.links.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
